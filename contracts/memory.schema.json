{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErisMemory",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "category": { "type": "string", "enum": ["preference", "fact", "instruction", "project"] },
    "content": { "type": "string" },
    "pinned": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": ["id", "created_at", "category", "content", "pinned"]
}
